# Статичная база .env — одинаково во всех окружениях, секретов тут нет.
# CI доставляет этот файл на сервер и дописывает поверх значения из GitHub
# vars/secrets (APP_ENV/APP_URL/APP_KEY/пароли…), собирая финальный /app/.env.
# Не держи здесь ключей из vars/secrets — задвоение приведёт к непредсказуемому
# значению в phpdotenv.

APP_NAME=Laravel
LOG_CHANNEL=stack
LOG_STACK=single

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
# В стеке становятся POSTGRES_DB / POSTGRES_USER (одинаковы во всех окружениях —
# у каждого свой отдельный postgres). Пароль — секрет, тут его нет.
DB_DATABASE=laravel
DB_USERNAME=laravel

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Флаг обслуживания ОБЯЗАН лежать в Redis: file-драйвер пишет файл внутрь
# контейнера, и он исчезает на первом rolling update.
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
